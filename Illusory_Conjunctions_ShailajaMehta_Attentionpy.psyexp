        <Param val="digit_left = random.randint(1, 9)&amp;#10;digit_right = random.randint(1, 9)&amp;#10;&amp;#10;digitText.setText(f&quot;{digit_left}                         {digit_right}&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
